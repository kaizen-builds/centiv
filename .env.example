# Centiv — copy to .env.local and fill in. Never commit real values.
# Without these keys the app still runs in explicit simulated mode.

# --- SERV Reasoning (required for hackathon live path) ---
# https://console.openserv.ai/  → API key
# Docs: https://docs.openserv.ai/serv-reasoning/api
SERV_API_KEY=
# Optional overrides:
# SERV_BASE_URL=https://inference-api.openserv.ai/v1
# SERV_MODEL=gpt-5.4-mini

# --- Reppo Evaluation API ---
# Sign in at https://eval.reppo.xyz → API Key sidebar
# Live agent guide: https://eval.reppo.xyz/agents.md
# Concepts: https://docs.reppo.ai/concepts/evaluation-api
# Do not send private data — evaluations are public / panel-scored.
REPPO_API_KEY=
# Optional: REPPO_BASE_URL=https://eval.reppo.xyz/api/v1

# --- Kite Passport ---
# Official path is the kpass CLI (no public HTTP API yet):
# https://docs.gokite.ai/passport
# https://docs.gokite.ai/reference/kpass-cli
# https://docs.gokite.ai/passport/payments
# Centiv always enforces budget / per-tx / TTL mid-task locally.
# Public runs ALWAYS settle as Simulated (sim_ receipts). Real payments only via
# the owner-gated local route /api/live — never set these on Vercel:
# CENTIV_LIVE_TOKEN=            # >= 24 chars, e.g. $(openssl rand -hex 16)
# CENTIV_LIVE_SESSION_ID=       # passkey-approved Passport session id
# CENTIV_LIVE_MAX_PER_CALL_USDC=0.01
# CENTIV_LIVE_MAX_TOTAL_USDC=0.05
# CENTIV_LIVE_MAX_SESSION_USDC=0.10
# KPASS_BIN=~/.local/bin/kpass

# --- x402 paid data source ---
# Prefer a Kite catalogue / kite-x402-* service. Official test example:
#   https://x402.dev.gokite.ai/api/weather?location=San%20Francisco
# Research use case (funding) uses Centiv's local catalogue at /api/data/funding
# unless you point this at an upstream that returns HTTP 402 + PAYMENT-REQUIRED.
# X402_DATA_URL=
# X402_FUNDING_PRICE_USDC=0.18
# X402_PAY_TO=0xYourReceivingAddress
